# Database - Use PostgreSQL URL for production
# DATABASE_URL="postgresql://user:password@host:5432/sekolah_erp?schema=public"
DATABASE_URL="file:./dev.db"

# JWT - CHANGE THESE IN PRODUCTION!
JWT_SECRET=change-this-to-a-long-random-string-min-32-chars-in-production
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=change-this-to-another-long-random-string-min-32-chars
JWT_REFRESH_EXPIRES_IN=7d

# App
PORT=4000
CORS_ORIGIN=http://localhost:3000
NODE_ENV=development

# Rate Limiting
THROTTLE_TTL=60000
THROTTLE_LIMIT=100
